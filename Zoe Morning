<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Good Morning, Sunshine ☀️</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(180deg, #1d1b38 0%, #3a234c 30%, #a14568 60%, #ff7e5f 85%, #feb47b 100%);
            color: #ffffff;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            padding: 20px;
            overflow-x: hidden;
        }

        /* Animated Glowing Sun */
        .sun-container {
            margin-top: 35px;
            position: relative;
            width: 130px;
            height: 130px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sun {
            width: 85px;
            height: 85px;
            background: radial-gradient(circle, #fff7ad 20%, #ffd166 100%);
            border-radius: 50%;
            box-shadow: 0 0 40px #ffd166, 0 0 80px #ff7e5f;
            animation: pulse 3s infinite alternate;
        }

        @keyframes pulse {
            0% { transform: scale(0.95); box-shadow: 0 0 30px #ffd166; }
            100% { transform: scale(1.05); box-shadow: 0 0 60px #ffd166, 0 0 90px #ff7e5f; }
        }

        .header {
            text-align: center;
            margin-top: 18px;
        }

        .header h1 {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 6px;
            text-shadow: 0 2px 10px rgba(0,0,0,0.2);
        }

        .header p {
            font-size: 0.98rem;
            opacity: 0.9;
            font-weight: 300;
        }

        /* Glass Cards */
        .card {
            background: rgba(255, 255, 255, 0.18);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 20px;
            padding: 22px;
            width: 100%;
            max-width: 350px;
            margin-top: 22px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
            text-align: center;
        }

        .card h2 {
            font-size: 1.15rem;
            margin-bottom: 12px;
            color: #fff;
        }

        .message-text {
            font-size: 0.98rem;
            line-height: 1.5;
            color: #fff;
            min-height: 65px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 5px;
        }

        .btn {
            background: #ffffff;
            color: #d94b68;
            border: none;
            padding: 12px 20px;
            border-radius: 30px;
            font-weight: 600;
            font-size: 0.92rem;
            margin-top: 15px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            transition: transform 0.15s ease;
            width: 100%;
        }

        .btn:active {
            transform: scale(0.96);
        }

        /* Photo Grid */
        .photo-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            width: 100%;
            max-width: 350px;
            margin-top: 20px;
        }

        .photo-card {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 16px;
            overflow: hidden;
            height: 140px;
            border: 1px solid rgba(255, 255, 255, 0.25);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .photo-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .footer {
            margin-top: 35px;
            padding-bottom: 20px;
            font-size: 0.85rem;
            opacity: 0.85;
            text-align: center;
        }
    </style>
</head>
<body>

    <div class="sun-container">
        <div class="sun"></div>
    </div>

    <div class="header">
        <h1>Good Morning, Beautiful 🌅</h1>
        <p>I hope you slept beautifully! Here is a little morning warmth for you zoe 🥹.</p>
    </div>

    <div class="card">
        <h2>💌 Morning Love Note</h2>
        <div class="message-text" id="note">
            Waking up and knowing you're in my life is the best feeling in the world.
        </div>
        <button class="btn" onclick="nextNote()">Tap for another sweet message 💖</button>
    </div>

    <div class="photo-grid">
        <div class="photo-card">
            <!-- Replace this src link with your own photo URL -->
            <a href="https://ibb.co/jZP1Tqq9"><img src="https://i.ibb.co/LhX28BBD/IMG-4184.jpg" alt="IMG-4184" border="0"></a> 
        </div>
        <div class="photo-card">
            <!-- Replace this src link with your own photo URL -->
            <a href="https://ibb.co/DfcD9z9D"><img src="https://i.ibb.co/YBn7cPc7/IMG-3734.jpg" alt="IMG-3734" border="0"></a>
        </div>
    </div>

    <div class="card">
        <h2>✨ Reason Why I Love You</h2>
        <div class="message-text" id="reason">
            I love your laugh and how contagious it is.
        </div>
        <button class="btn" onclick="nextReason()">Tap for another reason ☀️</button>
    </div>

    <!-- Music Player Card -->
    <div class="card">
        <h2> Our Song</h2>
        <div style="border-radius: 12px; overflow: hidden; margin-top: 10px;">
            <iframe width="100%" height="160" src="https://www.youtube.com/embed/dElRVQFqj-k" title="Bruno Mars - Marry You" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
    </div>

    <div class="footer">
        Made with ❤️ specially for you
    </div>

    <script>
        const notes = [
            "Waking up and knowing you're in my life is the best feeling in the world.",
            "You mean everything to me.",
            "I can't wait to call you again!",
            "I hope your morning is as warm, bright, and beautiful as you are."
        ];

        const reasons = [
            "I love your laugh and how contagious it is.",
            "I love how thoughtful and caring you are.",
            "By the way, I love your new nails! They look so good on you 💅✨",
            "Because having you in my life makes every single day so much brighter."
        ];

        let noteIdx = 0;
        let reasonIdx = 0;

        function nextNote() {
            noteIdx = (noteIdx + 1) % notes.length;
            document.getElementById('note').innerText = notes[noteIdx];
        }

        function nextReason() {
            reasonIdx = (reasonIdx + 1) % reasons.length;
            document.getElementById('reason').innerText = reasons[reasonIdx];
        }
    </script>
</body>
</html>
